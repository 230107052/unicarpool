# Copy to .env (never commit .env)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The Worker needs service_role to read all pending notifications. KEEP SECRET.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
POLL_INTERVAL_MS=10000
# SMTP (leave SMTP_HOST empty in development: e-mails are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UniCarpool <no-reply@example.edu>"
